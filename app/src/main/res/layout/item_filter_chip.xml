<?xml version="1.0" encoding="utf-8"?>
<!--
    Заготовка выбираемого чипа.

    Чипы создаются в коде, а стиль классу задать в конструкторе нельзя —
    поэтому заготовка лежит отдельным файлом и раздувается через
    LayoutInflater. Только так к чипу применяется стиль со списками
    состояний, благодаря которым видно, что он выбран.
-->
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Diary.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="true"
    tools:text="😄 Отлично" />
