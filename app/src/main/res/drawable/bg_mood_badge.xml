<?xml version="1.0" encoding="utf-8"?>
<!-- Подложка плашки настроения на экране записи.
     Цвет обводки и текста задаётся из кода — он зависит от настроения. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceVariant" />
    <corners android:radius="18dp" />
    <padding
        android:left="12dp"
        android:top="6dp"
        android:right="12dp"
        android:bottom="6dp" />
</shape>
