<?xml version="1.0" encoding="utf-8"?>
<!-- Обводка чипа: у невыбранных она отделяет чип от фона экрана,
     у выбранного совпадает с заливкой. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/brand_purple" />
    <item android:color="@color/divider" />
</selector>
