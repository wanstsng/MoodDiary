<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Тёмный вариант темы. Цвета подставляются из values-night/colors.xml
        автоматически, поэтому здесь остаётся только то, что действительно
        зависит от режима: цвет иконок в системной строке состояния.
    -->
    <style name="Theme.Diary" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_purple_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_purple</item>
        <item name="colorSecondary">@color/brand_purple</item>
        <item name="colorError">@color/danger</item>

        <item name="android:colorBackground">@color/surface_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceVariant">@color/surface_input</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>

        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
        <!-- В тёмной теме иконки статус-бара должны быть светлыми. -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <item name="materialAlertDialogTheme">@style/Theme.Diary.Dialog</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Diary.Headline</item>
    </style>
</resources>
